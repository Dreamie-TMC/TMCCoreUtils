<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>net48</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWindowsForms>true</UseWindowsForms>
        <LangVersion>default</LangVersion>
        <Nullable>enable</Nullable>
        <Title>TMC.Tools.CoreLib</Title>
        <Authors>DreamieTMC</Authors>
        <Description>Core utilities for use with external tools target TLoZ: Minish Cap that interface through Bizhawk.</Description>
        <RepositoryUrl>https://github.com/Dreamie-TMC/TMCCoreUtils</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Configurations>SpeedrunToolsDebug;SpeedrunTools;TasingToolsDebug;TasingTools</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SpeedrunToolsDebug|AnyCPU' ">
        <Optimize>False</Optimize>
        <BIZHAWK_DATA_HOME>$(ProjectDir)../../MinishCapSpeedrunTools/BizHawk/</BIZHAWK_DATA_HOME>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'SpeedrunTools|AnyCPU' ">
        <Optimize>True</Optimize>
        <BIZHAWK_DATA_HOME>$(ProjectDir)../../MinishCapSpeedrunTools/BizHawk/</BIZHAWK_DATA_HOME>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'TasingToolsDebug|AnyCPU' ">
        <Optimize>False</Optimize>
        <BIZHAWK_DATA_HOME>$(ProjectDir)../../MinishCapTasingTools/BizHawk/</BIZHAWK_DATA_HOME>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'TasingTools|AnyCPU' ">
        <Optimize>True</Optimize>
        <BIZHAWK_DATA_HOME>$(ProjectDir)../../MinishCapTasingTools/BizHawk/</BIZHAWK_DATA_HOME>
    </PropertyGroup>
    
    <ItemGroup>
        <Reference Include="BizHawk.Client.Common" HintPath="$(BIZHAWK_DATA_HOME)dll/BizHawk.Client.Common.dll" />
        <Reference Include="BizHawk.Emulation.Common" HintPath="$(BIZHAWK_DATA_HOME)dll/BizHawk.Emulation.Common.dll" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Core\Resources\tmc_tool_icon.ico" />
      <EmbeddedResource Include="Core\Resources\tmc_tool_icon.ico" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(OutputPath)$(MSBuildProjectName).dll" DestinationFolder="$(BIZHAWK_DATA_HOME)ExternalTools/dll" />
    </Target>
</Project>
